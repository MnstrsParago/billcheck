# Server-only. Set these in Vercel → Project → Settings → Environment Variables.
ANTHROPIC_API_KEY=
# Upstash Redis (Vercel Marketplace integration sets KV_REST_API_URL / KV_REST_API_TOKEN automatically)
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Resend (email reminders). Free test sender onboarding@resend.dev only delivers to the account owner.
RESEND_API_KEY=
